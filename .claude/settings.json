{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm install --frozen-lockfile 2>&1 | tail -3 || echo 'pnpm install failed — run it manually'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install:*)",
      "Bash(pnpm check)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build)",
      "Bash(pnpm format)",
      "Bash(pnpm dev)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Read",
      "Grep",
      "Glob"
    ],
    "deny": [
      "Read(.project-config.json)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
