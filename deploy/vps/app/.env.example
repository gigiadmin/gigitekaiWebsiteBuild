# Phase 2 — full application environment. Copy to /opt/gigitekai/.env and fill in.
# Use ROTATED values; never the ones that were committed in .project-config.json.
# Required to boot: DATABASE_URL JWT_SECRET JWT_RESET_SECRET VITE_APP_ID OAUTH_SERVER_URL VITE_OAUTH_PORTAL_URL OWNER_OPEN_ID OWNER_NAME BUILT_IN_FORGE_API_URL BUILT_IN_FORGE_API_KEY VITE_FRONTEND_FORGE_API_KEY VITE_FRONTEND_FORGE_API_URL
# Everything else enables a specific integration; leave blank to disable it.
