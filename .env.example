# ============================================================
# GigitekAI — Environment Variable Example (no secret values)
# Copy to .env.local for development; set via Key Vault in production.
# ============================================================

NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# ------------------------------------------------------------------
# Database (MySQL / Azure Database for MySQL Flexible Server)
# ------------------------------------------------------------------
DATABASE_URL=mysql://gigitekai_app:REPLACE_ME@localhost:3306/gigitekai
DB_HOST=localhost
DB_USER=gigitekai_app
DB_PASSWORD=REPLACE_ME
DB_NAME=gigitekai

# ------------------------------------------------------------------
# Session / JWT
# ------------------------------------------------------------------
JWT_SECRET=local-dev-jwt-secret-min-32-chars-long
JWT_RESET_SECRET=local-dev-reset-secret-min-32-chars-long

# ------------------------------------------------------------------
# Identity (Microsoft Entra OIDC for admin — replaces Manus OAuth)
# ------------------------------------------------------------------
MS_GRAPH_TENANT_ID=your-tenant-id
MS_GRAPH_CLIENT_ID=your-app-client-id
MS_GRAPH_CLIENT_SECRET=your-app-client-secret
ADMIN_EMAILS=admin@gigitekai.com

# ------------------------------------------------------------------
# Azure Storage (Blob) — replaces Manus storage proxy
# ------------------------------------------------------------------
AZURE_STORAGE_ACCOUNT_NAME=gigitekaistorage
AZURE_STORAGE_CONTAINER=app-files
# Use managed identity in production; this fallback is for local dev only:
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# ------------------------------------------------------------------
# AI Providers (Aria / LLMProvider adapters)
# ------------------------------------------------------------------
CLAUDE_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://...openai.azure.com/
# Optional Ollama gateway (private network or local dev)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b

# ------------------------------------------------------------------
# Azure Communication Services (email, voice, SMS, call flows)
# ------------------------------------------------------------------
ACS_CONNECTION_STRING=endpoint=https://...;accesskey=...
ACS_RESOURCE_ID=/subscriptions/.../resourceGroups/.../providers/Microsoft.Communication/CommunicationServices/...
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=westus2

# ------------------------------------------------------------------
# Teams / Microsoft Graph
# ------------------------------------------------------------------
TEAMS_WEBHOOK_URL=https://gigitekai.webhook.office.com/webhookb2/...
TEAMS_BOT_TENANT_ID=...
TEAMS_BOT_APP_ID=...
TEAMS_BOT_CLIENT_SECRET=...
TEAMS_BOT_TEAM_ID=...
TEAMS_BOT_CHANNEL_ID=...

# ------------------------------------------------------------------
# Monitoring / Observability
# ------------------------------------------------------------------
SENTRY_DSN=https://...@sentry.io/...
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
UPTIMEROBOT_API_KEY=...

# ------------------------------------------------------------------
# Integrations
# ------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
SENDGRID_API_KEY=SG...
RECAPTCHA_SECRET_KEY=...

# ------------------------------------------------------------------
# Social OAuth (callback URLs must be updated in provider consoles)
# ------------------------------------------------------------------
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...
LINKEDIN_ACCESS_TOKEN=...
LINKEDIN_PERSON_URN=...
TWITTER_API_KEY=...
TWITTER_API_SECRET=...
TWITTER_ACCESS_TOKEN=...
TWITTER_ACCESS_SECRET=...
FACEBOOK_APP_ID=...
FACEBOOK_APP_SECRET=...

# ------------------------------------------------------------------
# Migration / Cutover flags
# ------------------------------------------------------------------
RUN_SCHEDULERS=false
AZURE_STORAGE_USE_MANAGED_IDENTITY=false
