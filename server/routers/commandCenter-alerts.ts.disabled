/**
 * Command Center Alert Management Router
 * Create, update, delete, and manage alerts for uptime, performance, and custom thresholds
 */

import { router, protectedProcedure } from "../_core/trpc";
import { z } from "zod";
import { eq, and, desc } from "drizzle-orm";
import { getDb } from "../db";
import { commandCenterAlerts, commandCenterAlertsTriggered } from "../../drizzle/schema";
import { TRPCError } from "@trpc/server";

export const commandCenterAlertsRouter = router({
  /**
   * Get all alerts for current user
   */
  getAlerts: protectedProcedure
    .input(
      z.object({
        limit: z.number().default(50),
      })
    )
    .query(async ({ ctx, input }) => {
      const db = await getDb();
      if (!db) throw new Error("Database unavailable");

      const alerts = await db
        .select()
        .from(commandCenterAlerts)
        .where(eq(commandCenterAlerts.userId, ctx.user.id))
        .orderBy(desc(commandCenterAlerts.createdAt))
        .limit(input.limit);

      return alerts.map((a: any) => ({
        id: a.id,
        name: a.name,
        description: a.description,
        type: a.type,
        condition: a.condition ? JSON.parse(a.condition as string) : {},
        threshold: a.threshold,
        notificationChannels: a.notificationChannels
          ? JSON.parse(a.notificationChannels as string)
          : [],
        isActive: a.isActive === 1,
        createdAt: a.createdAt,
        updatedAt: a.updatedAt,
      }));
    }),

  /**
   * Create a new alert
   */
  createAlert: protectedProcedure
    .input(
      z.object({
        name: z.string(),
        description: z.string().optional(),
        type: z.enum(["uptime", "performance", "email", "ticket", "agent", "custom"]),
        threshold: z.number(),
        condition: z.record(z.string(), z.unknown()).optional(),
        notificationChannels: z.array(z.enum(["email", "sms", "teams", "slack", "webhook"])).default(["email"]),
      })
    )
    .mutation(async ({ ctx, input }) => {
      const db = await getDb();
      if (!db) throw new Error("Database unavailable");

      const result = await (db.insert(commandCenterAlerts) as any).values({
        userId: ctx.user.id,
        name: input.name,
        description: input.description,
        type: input.type,
        threshold: input.threshold,
        condition: input.condition ? JSON.stringify(input.condition) : null,
        notificationChannels: JSON.stringify(input.notificationChannels),
        isActive: 1,
      });

      return { id: result[0].insertId, ...input };
    }),

  /**
   * Update an alert
   */
  updateAlert: protectedProcedure
    .input(
      z.object({
        id: z.number(),
        name: z.string().optional(),
        description: z.string().optional(),
        threshold: z.number().optional(),
        condition: z.record(z.string(), z.unknown()).optional(),
        notificationChannels: z.array(z.enum(["email", "sms", "teams", "slack", "webhook"])).optional(),
        isActive: z.boolean().optional(),
      })
    )
    .mutation(async ({ ctx, input }) => {
      const db = await getDb();
      if (!db) throw new Error("Database unavailable");

      const { id, ...updates } = input;

      const updateData: any = {};
      if (updates.name !== undefined) updateData.name = updates.name;
      if (updates.description !== undefined) updateData.description = updates.description;
      if (updates.threshold !== undefined) updateData.threshold = updates.threshold;
      if (updates.condition !== undefined) updateData.condition = JSON.stringify(updates.condition);
      if (updates.notificationChannels !== undefined) updateData.notificationChannels = JSON.stringify(updates.notificationChannels);
      if (updates.isActive !== undefined) updateData.isActive = updates.isActive ? 1 : 0;
      updateData.updatedAt = new Date();

      await (db.update(commandCenterAlerts) as any)
        .set(updateData)
        .where(and(eq(commandCenterAlerts.id, id), eq(commandCenterAlerts.userId, ctx.user.id)));

      return { id, ...updates };
    }),

  /**
   * Delete an alert
   */
  deleteAlert: protectedProcedure
    .input(z.object({ id: z.number() }))
    .mutation(async ({ ctx, input }) => {
      const db = await getDb();
      if (!db) throw new Error("Database unavailable");

      await (db.delete(commandCenterAlerts) as any)
        .where(and(eq(commandCenterAlerts.id, input.id), eq(commandCenterAlerts.userId, ctx.user.id)));

      return { success: true };
    }),

  /**
   * Get alert history/triggers
   */
  getAlertHistory: protectedProcedure
    .input(
      z.object({
        alertId: z.number().optional(),
        limit: z.number().default(50),
      })
    )
    .query(async ({ ctx, input }) => {
      const db = await getDb();
      if (!db) throw new Error("Database unavailable");

      let query = db
        .select()
        .from(commandCenterAlertsTriggered);

      if (input.alertId) {
        query = query.where(eq(commandCenterAlertsTriggered.alertId, input.alertId));
      }

      const history = await query
        .orderBy(desc(commandCenterAlertsTriggered.createdAt))
        .limit(input.limit);

      return history.map((h: any) => ({
        id: h.id,
        alertId: h.alertId,
        value: h.value,
        message: h.message,
        notificationSent: h.notificationSent === 1,
        createdAt: h.createdAt,
      }));
    }),

  /**
   * Trigger an alert manually (for testing)
   */
  triggerAlert: protectedProcedure
    .input(
      z.object({
        alertId: z.number(),
        value: z.number(),
        message: z.string().optional(),
      })
    )
    .mutation(async ({ ctx, input }) => {
      const db = await getDb();
      if (!db) throw new Error("Database unavailable");

      // Verify alert belongs to user
      const alert = await db
        .select()
        .from(commandCenterAlerts)
        .where(and(eq(commandCenterAlerts.id, input.alertId), eq(commandCenterAlerts.userId, ctx.user.id)))
        .limit(1);

      if (!alert.length) {
        throw new TRPCError({ code: "NOT_FOUND", message: "Alert not found" });
      }

      // Create trigger record
      const result = await (db.insert(commandCenterAlertsTriggered) as any).values({
        alertId: input.alertId,
        value: input.value,
        message: input.message || "Manual test trigger",
        notificationSent: 1,
      });

      return { id: result[0].insertId, ...input };
    }),

  /**
   * Resolve an alert
   */
  resolveAlert: protectedProcedure
    .input(z.object({ alertId: z.number() }))
    .mutation(async ({ ctx, input }) => {
      const db = await getDb();
      if (!db) throw new Error("Database unavailable");

      // Verify alert belongs to user
      const alert = await db
        .select()
        .from(commandCenterAlerts)
        .where(and(eq(commandCenterAlerts.id, input.alertId), eq(commandCenterAlerts.userId, ctx.user.id)))
        .limit(1);

      if (!alert.length) {
        throw new TRPCError({ code: "NOT_FOUND", message: "Alert not found" });
      }

      // Update alert to inactive
      await (db.update(commandCenterAlerts) as any)
        .set({ isActive: 0, updatedAt: new Date() })
        .where(eq(commandCenterAlerts.id, input.alertId));

      return { success: true };
    }),
});
